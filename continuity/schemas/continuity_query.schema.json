{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://blu-core.local/continuity/schemas/continuity_query.schema.json",
  "title": "ContinuityQuery",
  "description": "Bounded, single-scope continuity retrieval request.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "query_id",
    "provider_id",
    "scope",
    "selector",
    "status_filter",
    "version_selector",
    "limit",
    "cursor",
    "include_payload",
    "authorization_ref"
  ],
  "properties": {
    "query_id": {"type": "string", "minLength": 1},
    "provider_id": {"type": "string", "minLength": 1},
    "scope": {"$ref": "continuity_record.schema.json#/$defs/scope"},
    "selector": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["record_id"],
          "properties": {"record_id": {"type": "string", "minLength": 1}}
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["record_type"],
          "properties": {"record_type": {"type": "string", "minLength": 1}}
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["search_terms"],
          "properties": {
            "search_terms": {
              "type": "array",
              "minItems": 1,
              "maxItems": 8,
              "items": {"type": "string", "minLength": 1, "maxLength": 200}
            }
          }
        }
      ]
    },
    "status_filter": {"enum": ["current", "retired", "superseded", "history", "any"]},
    "version_selector": {
      "oneOf": [
        {"const": "current"},
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["exact_version"],
          "properties": {"exact_version": {"type": "integer", "minimum": 1}}
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["as_of"],
          "properties": {"as_of": {"type": "string", "format": "date-time"}}
        }
      ]
    },
    "limit": {"type": "integer", "minimum": 1, "maximum": 100},
    "cursor": {"type": ["string", "null"]},
    "include_payload": {"type": "boolean"},
    "authorization_ref": {"type": ["string", "null"]}
  },
  "x-blu-scope-rule": "One query names one exact scope. Providers must not silently merge incompatible namespaces, subjects, owners, or purposes.",
  "x-blu-default-rule": "Ordinary retrieval requests current records only; historical retrieval is explicit."
}
