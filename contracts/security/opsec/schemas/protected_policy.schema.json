{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://blu-core.local/contracts/security/opsec/schemas/protected_policy.schema.json",
  "title": "ProtectedOpsecPolicy",
  "description": "Schema is public; conforming production values remain outside the public repository.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "policy_id", "revision", "evidence_hmac_key", "rules"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "policy_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{2,127}$"},
    "revision": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"},
    "evidence_hmac_key": {"type": "string", "minLength": 32, "maxLength": 256},
    "rules": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["rule_ref", "matcher", "value", "case_sensitive", "applies_to", "ingress_action", "egress_action", "safe_reason_code"],
        "properties": {
          "rule_ref": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{2,127}$"},
          "matcher": {"const": "normalized_phrase"},
          "value": {"type": "string", "minLength": 3, "maxLength": 4096},
          "case_sensitive": {"type": "boolean"},
          "applies_to": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {"enum": ["ingress", "egress"]}
          },
          "ingress_action": {"const": "BLOCK"},
          "egress_action": {"enum": ["BLOCK", "REDACT"]},
          "safe_reason_code": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]{2,63}$"}
        }
      }
    }
  },
  "x-blu-protected-fields": ["evidence_hmac_key", "rules[].value"],
  "x-blu-auth-fields-forbidden": true
}
