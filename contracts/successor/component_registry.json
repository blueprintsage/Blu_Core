  "state_lifetime_values": ["none", "turn", "host_session", "durable_external"],
  "state_lifetime_contract": {
    "bare_session_allowed": false,
    "none": "no retained state",
    "turn": "discarded after the current host turn terminal receipt unless explicitly exported",
    "host_session": "host-owned cross-turn state accepted only with provider, binding method, scope, freshness, state identity, expiry, and receipt evidence",
    "durable_external": "external state accepted only through an explicit continuity operation with version, provenance, and receipt",
    "cross_turn_rule": "the deterministic core never invents or invisibly retains cross-turn state; without evidenced host_session state or explicitly requested durable_external state, cross-turn continuation is UNAVAILABLE and fails closed where security requires it"
