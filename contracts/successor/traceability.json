  "requirements": [
    {"successor_requirement_id": "SKR-001", "successor_component_or_boundary": "security_restraint", "requirement": "OPSEC runs before ordinary ingress, returns PASS, BLOCK, or ASK without publishing protected content, and re-evaluates any bounded pre-ingress AuthorizationResult before Turn Controller entry.", "evidence_class": "approved owner/lead decision", "evidence_ref": ["EVID-DEC-OPSEC", "EVID-BC017-OPSEC"], "decision_ref": "BC-018 section 5.4 plus pre-review correction", "notes": "Successor decision; not a repair to current CTS provenance."},
    {"successor_requirement_id": "SKR-002", "successor_component_or_boundary": "authorization_evaluator", "requirement": "Authorization evaluates a bounded action and resource against explicit evidence; conversational identity inference is insufficient; pre-ingress results return to the separate Security Restraint without ordinary routing.", "evidence_class": "mixed", "evidence_ref": ["EVID-DEC-AUTH", "EVID-BC010-UR003", "EVID-BC017-AUTH"], "decision_ref": "BC-018 Auth boundary plus pre-review correction", "notes": "Protected answers are excluded; Auth and OPSEC remain separate owners."},
    {"successor_requirement_id": "SKR-003", "successor_component_or_boundary": "turn_controller", "requirement": "Only SecurityDecision PASS plus minimized allowed_input enters the Turn Controller, which solely constructs TurnRequest before resolving one route, one owner, one ScopeLock, and declared dependencies.", "evidence_class": "mixed", "evidence_ref": ["EVID-CTS-EXEC", "EVID-BC010-PARITY003", "EVID-BC017-EXEC"], "decision_ref": "BC-018 minimal control flow plus pre-review correction", "notes": "Host Adapter produces raw_host_input, not TurnRequest; no Exec component survives."},
    {"successor_requirement_id": "SKR-004", "successor_component_or_boundary": "validation_egress", "requirement": "No deterministic-lane public output bypasses terminal, scope, source, and proof validation.", "evidence_class": "mixed", "evidence_ref": ["EVID-CTS-OPS", "EVID-BC010-PARITY006"], "decision_ref": "BC-018 egress boundary", "notes": "Ordinary conversation may degrade safely when optional services are absent."},
    {"successor_requirement_id": "SKR-005", "successor_component_or_boundary": "model_execution_boundary", "requirement": "Persona, warmth, pedagogy, interpretation, and natural-language expression remain model-facing.", "evidence_class": "mixed", "evidence_ref": ["EVID-CTS-PERSONA", "EVID-BC017-TEACH"], "decision_ref": "BC-018 model boundary", "notes": "Deterministic Python must not replace Blu."},
    {"successor_requirement_id": "SKR-006", "successor_component_or_boundary": "host_adapter_boundary", "requirement": "The generic core consumes capability and provider receipts without Chat- or Codex-specific assumptions.", "evidence_class": "approved owner/lead decision", "evidence_ref": ["EVID-BC015-CAP001", "EVID-ASSIGN-BC020"], "decision_ref": "BC-018/BC-020 boundary", "notes": "Specific adapters remain BC-020."},
    {"successor_requirement_id": "SKR-007", "successor_component_or_boundary": "continuity_provider_boundary", "requirement": "Durable state requires an external, versioned continuity result and receipt.", "evidence_class": "mixed", "evidence_ref": ["EVID-CTS-MEMORY", "EVID-BC017-PERSIST", "EVID-ASSIGN-BC030"], "decision_ref": "BC-018/BC-030 boundary", "notes": "Local Mirror details remain BC-030."},
