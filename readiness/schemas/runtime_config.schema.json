{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://blu-core.local/readiness/schemas/runtime_config.schema.json",
  "title": "BluRuntimeConfiguration",
  "description": "Portable Phase 1 configuration; configuration is never capability evidence or Blu canon.",
  "type": "object",
  "additionalProperties": false,
  "required": ["model_provider", "continuity_provider", "host_adapter", "runtime", "development"],
  "properties": {
    "model_provider": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "api_profile", "endpoint", "selected_model", "timeout_seconds", "context", "stream", "store", "authentication_env"],
      "properties": {
        "type": {"const": "lm_studio"},
        "api_profile": {"const": "native_rest_v1"},
        "endpoint": {"type": "string", "pattern": "^https?://[^/]+(?::[0-9]+)?$", "default": "http://127.0.0.1:1234"},
        "selected_model": {"type": "string", "minLength": 1},
        "timeout_seconds": {"type": "number", "minimum": 1, "maximum": 300, "default": 60},
        "context": {
          "type": "object",
          "additionalProperties": false,
          "required": ["requested_tokens", "require_observed_capacity"],
          "properties": {
            "requested_tokens": {"type": "integer", "minimum": 512},
            "require_observed_capacity": {"const": true}
          }
        },
        "stream": {"const": false},
        "store": {"const": false},
        "authentication_env": {"type": ["string", "null"], "pattern": "^[A-Z][A-Z0-9_]*$"}
      }
    },
    "continuity_provider": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "required_for_phase1"],
      "properties": {"type": {"const": "unavailable"}, "required_for_phase1": {"const": false}}
    },
    "host_adapter": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type"],
      "properties": {"type": {"const": "terminal"}}
    },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "logging", "protected_policy_ref"],
      "properties": {
        "mode": {"const": "phase1_ordinary_conversation"},
        "logging": {"enum": ["safe", "diagnostic_no_content"]},
        "protected_policy_ref": {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "locator_env", "sha256_env"],
          "properties": {
            "kind": {"const": "environment_file"},
            "locator_env": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]*$"},
            "sha256_env": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]*$"}
          },
          "description": "Portable opaque binding. Configuration stores environment-variable names only; the environment supplies the machine-local protected policy location and expected SHA-256 digest. Reference presence is not policy usability evidence."
        }
      }
    },
    "development": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fixture_provider", "allow_unverified_capabilities", "allow_protected_routes"],
      "properties": {
        "fixture_provider": {"type": ["string", "null"]},
        "allow_unverified_capabilities": {"const": false},
        "allow_protected_routes": {"const": false}
      }
    }
  },
  "x-blu-portability-rules": [
    "No canonical identity, Persona, behavioral law, or protected value appears in configuration.",
    "No machine-specific filesystem path is a portable default.",
    "Endpoint and selected model configuration do not prove availability or capability.",
    "Secrets and protected policy locations or digests are environment bindings, never embedded values.",
    "A protected-policy reference is not usable until its target is located, loaded, schema-valid, integrity-valid, and policy-usable."
  ]
}
